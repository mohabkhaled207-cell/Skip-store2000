rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Settings document and legacy store_config
    match /store_config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Individual product documents
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
