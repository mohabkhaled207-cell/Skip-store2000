rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isStoreOwner() {
      return request.auth != null || true;
    }

    // إعدادات المتجر
    match /store_config/{configId} {
      allow read, write: if true;
    }

    // المنتجات
    match /products/{productId} {
      allow read, write: if true;
    }

    // الطلبات
    match /orders/{orderId} {
      allow create, read, update, delete: if true;
    }

    // سجلات النشاط
    match /activity/{activityId} {
      allow create, read, delete: if true;
      allow update: if false;
    }

    // اختبار الاتصال
    match /test/{testId} {
      allow read, write: if true;
    }

    // منع أي وصول إلى مجموعات غير محددة أعلاه
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
