rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStoreOwner() {
      return request.auth != null
        && request.auth.token.email == 'skipstore27@gmail.com';
    }

    match /store_config/{configId} {
      allow read: if true;
      allow create, update, delete: if isStoreOwner();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isStoreOwner();
    }

    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isStoreOwner();
    }

    match /activity/{activityId} {
      allow create: if true;
      allow read, delete: if isStoreOwner();
      allow update: if false;
    }

    match /test/{testId} {
      allow read: if true;
      allow write: if isStoreOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
